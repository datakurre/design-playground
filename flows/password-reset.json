{
  "$schema": "./flow.schema.json",
  "id": "password-reset",
  "goal": "Let a locked-out user regain access safely, without revealing whether an email is registered.",
  "intents": ["password reset", "reset password", "forgot password", "forgot my password", "can't log in", "locked out"],
  "steps": [
    {
      "id": "request",
      "title": "Reset your password",
      "description": "Single field; the response must not disclose account existence.",
      "components": ["form", "input", "button"],
      "fields": [
        { "name": "email", "label": "Email address", "variant": "email", "required": true, "autocomplete": "email" }
      ],
      "submitLabel": "Send reset link",
      "ruleTags": ["primary-action", "form-a11y", "minimal-input", "no-account-disclosure"]
    },
    {
      "id": "new-password",
      "title": "Choose a new password",
      "components": ["form", "input", "button"],
      "fields": [
        { "name": "password", "label": "New password", "variant": "password", "required": true, "autocomplete": "new-password", "help": "At least 12 characters." },
        { "name": "password-confirm", "label": "Repeat new password", "variant": "password", "required": true, "autocomplete": "new-password" }
      ],
      "submitLabel": "Set new password",
      "ruleTags": ["primary-action", "form-a11y"]
    }
  ],
  "success": {
    "title": "Password updated",
    "message": "You can now sign in with your new password. All other sessions were signed out."
  },
  "errors": [
    { "code": "token-expired", "message": "This reset link has expired.", "recovery": "Offer to send a fresh link to the same email with one click." },
    { "code": "password-mismatch", "message": "The passwords do not match.", "recovery": "Clear only the confirmation field and focus it." }
  ]
}
