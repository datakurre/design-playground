{
  "name": "design-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end demo: design tokens -> SQLite rule store -> MCP design server -> agent planner -> validated UI AST -> React renderer -> audit logs",
  "scripts": {
    "build:tokens": "tsx packages/tokens-build/src/build.ts",
    "db:seed": "tsx db/seed.ts",
    "db:verify": "tsx db/verify-enforcement.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "governance": "tsx scripts/generate-governance.ts",
    "pipeline": "pnpm build:tokens && pnpm db:seed && pnpm scenarios && pnpm governance",
    "screenshots": "tsx scripts/take-screenshots.ts",
    "site": "tsx scripts/build-site.ts",
    "storybook": "pnpm --filter @design-playground/renderer storybook",
    "storybook:build": "pnpm --filter @design-playground/renderer build-storybook",
    "test": "vitest run && vitest run -c vitest.storybook.config.ts",
    "test:stories": "vitest run -c vitest.storybook.config.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.2.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@design-playground/design-db": "workspace:*",
    "@design-playground/mcp-server": "workspace:*",
    "@design-playground/planner": "workspace:*",
    "@design-playground/tokens-build": "workspace:*",
    "@design-playground/ui-ir": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.24.0"
  }
}
