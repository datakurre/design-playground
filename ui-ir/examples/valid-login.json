{
  "type": "Screen",
  "id": "login",
  "title": "Sign in",
  "flow": "account-settings",
  "step": "sign-in",
  "children": [
    {
      "type": "Card",
      "children": [
        {
          "type": "Form",
          "id": "sign-in-form",
          "columns": 1,
          "children": [
            { "type": "Field", "name": "email", "label": "Email address", "inputType": "email", "required": true, "autocomplete": "email" },
            { "type": "Field", "name": "password", "label": "Password", "inputType": "password", "required": true, "autocomplete": "current-password" },
            { "type": "Button", "label": "Sign in", "variant": "primary", "action": { "kind": "submit", "target": "sign-in-form" } }
          ]
        }
      ]
    }
  ]
}
