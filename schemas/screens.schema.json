{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-playground.internal/screens.schema.json",
  "title": "Screen",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "path": { "type": "string" },
    "root": { "$ref": "#/$defs/node" }
  },
  "required": ["name", "path", "root"],
  "additionalProperties": false,
  "$comment": "`root` was {\"type\": \"object\"}. Keep this in step with Screens.screenNodeDecoder and screenNodeEncoder.",
  "$defs": {
    "node": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/componentInstance" },
        { "$ref": "#/$defs/screenInstance" },
        { "$ref": "#/$defs/container" },
        { "$ref": "#/$defs/text" }
      ]
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "componentInstance": {
      "type": "object",
      "properties": {
        "type": { "const": "component" },
        "componentName": { "type": "string" },
        "variant": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "children": { "$ref": "#/$defs/children" }
            },
            "required": ["name", "children"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "componentName", "slots"],
      "additionalProperties": false
    },
    "screenInstance": {
      "type": "object",
      "properties": {
        "type": { "const": "screen" },
        "screenName": { "type": "string" }
      },
      "required": ["type", "screenName"],
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "properties": {
        "type": { "const": "container" },
        "direction": { "type": "string" },
        "styles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "children": { "$ref": "#/$defs/children" }
      },
      "required": ["type", "direction", "styles", "children"],
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "content": { "type": "string" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    }
  }
}
