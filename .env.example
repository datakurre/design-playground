# OAuth application for this deployment.
#
# These used to be constants in src/Auth.elm, with the redirect URI hardcoded to
# https://datakurre.github.io/design-playground — so sign-in worked on that one
# deployment and nowhere else, local development included.
#
# Copy this file to .env and fill in the client id of a GitLab OAuth application
# registered with:
#
#   - Confidential: NO (this is a public client; PKCE, no client secret)
#   - Scopes:       read_api, write_repository
#   - Redirect URI: exactly the value of VITE_GITLAB_REDIRECT_URI below,
#                   or, if you leave that unset, your origin plus Vite's `base`
#                   (see vite.config.js) with no trailing slash —
#                   e.g. http://localhost:5173/design-playground
#
# GitLab compares the redirect URI literally, so a trailing slash or an http/
# https mismatch is a failed sign-in rather than a warning.

VITE_GITLAB_CLIENT_ID=

# Optional. Defaults to window.location.origin + Vite's base path, which is
# what you want for both `make dev` and a Pages deployment. Set it only when
# the browser's idea of the origin isn't what you registered — behind a proxy,
# or on a custom domain.
# VITE_GITLAB_REDIRECT_URI=http://localhost:5173/design-playground

# Optional. Defaults to "read_api write_repository", which covers everything the
# app does: reading a repository, and writing commits, branches and merge
# requests. The app previously asked for `api` — full read/write across every
# project the signed-in user can reach, which is far more than it needs and far
# more than a token cached in localStorage should carry.
# VITE_GITLAB_SCOPE=read_api write_repository
